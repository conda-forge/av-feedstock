From b618b2d9802cb8c4ac368ff97fc2873de05aab89 Mon Sep 17 00:00:00 2001
From: WyattBlue <wyattblue@auto-editor.com>
Date: Wed, 30 Sep 2026 17:43:14 -0400
Subject: [PATCH] Stop side data holding its frame in a reference cycle

Frame.side_data no longer caches its SideDataContainer on the frame, and
MotionVectors no longer memoizes the MotionVector objects it hands out;
both created reference cycles that kept frame buffers alive until gc ran.

Backported from upstream PyAV commit (post v19.0.0), with the
CHANGELOG.rst and av/about.py version bump hunks dropped:
https://github.com/PyAV-Org/PyAV/commit/b618b2d9802cb8c4ac368ff97fc2873de05aab89
---
 av/frame.pxd                  |  2 --
 av/frame.py                   |  4 +---
 av/frame.pyi                  |  3 ++-
 av/sidedata/motionvectors.pxd |  1 -
 av/sidedata/motionvectors.py  | 11 +----------
 av/sidedata/motionvectors.pyi |  7 +++----
 av/sidedata/sidedata.pyi      |  2 --
 7 files changed, 7 insertions(+), 23 deletions(-)

diff --git a/av/frame.pxd b/av/frame.pxd
index db37b56..8cb8aa5 100644
--- a/av/frame.pxd
+++ b/av/frame.pxd
@@ -1,7 +1,6 @@
 cimport libav as lib
 
 from av.packet cimport Packet
-from av.sidedata.sidedata cimport _SideDataContainer
 
 
 cdef class Frame:
@@ -9,6 +8,5 @@ cdef class Frame:
     # We define our own time.
     cdef lib.AVRational _time_base
     cdef void _rebase_time(self, lib.AVRational)
-    cdef _SideDataContainer _side_data
     cdef void _copy_internal_attributes(self, Frame source, bint data_layout=?)
     cdef void _init_user_attributes(self)
diff --git a/av/frame.py b/av/frame.py
index 2dbe964..5abead2 100644
--- a/av/frame.py
+++ b/av/frame.py
@@ -181,9 +181,7 @@ class Frame:
 
     @property
     def side_data(self):
-        if self._side_data is None:
-            self._side_data = SideDataContainer(self)
-        return self._side_data
+        return SideDataContainer(self)
 
     @property
     def metadata(self):
diff --git a/av/frame.pyi b/av/frame.pyi
index cd1d38d..ef0729e 100644
--- a/av/frame.pyi
+++ b/av/frame.pyi
@@ -11,7 +11,8 @@ class Frame:
     def time_base(self) -> AVRational: ...
     @time_base.setter
     def time_base(self, value: AVRational | Fraction | int) -> None: ...
-    side_data: SideDataContainer
+    @property
+    def side_data(self) -> SideDataContainer: ...
     opaque: object
     @property
     def metadata(self) -> dict[str, str]: ...
diff --git a/av/sidedata/motionvectors.pxd b/av/sidedata/motionvectors.pxd
index 0786483..1ee9a40 100644
--- a/av/sidedata/motionvectors.pxd
+++ b/av/sidedata/motionvectors.pxd
@@ -5,7 +5,6 @@ from av.sidedata.sidedata cimport SideData
 
 
 cdef class MotionVectors(SideData):
-    cdef dict _vectors
     cdef Py_ssize_t _len
 
 
diff --git a/av/sidedata/motionvectors.py b/av/sidedata/motionvectors.py
index 0c39993..f48aded 100644
--- a/av/sidedata/motionvectors.py
+++ b/av/sidedata/motionvectors.py
@@ -11,7 +11,6 @@ _cinit_bypass_sentinel = cython.declare(object, object())
 class MotionVectors(SideData):
     def __init__(self, sentinel, frame: Frame, index: cython.int):
         SideData.__init__(self, sentinel, frame, index)
-        self._vectors = {}
         self._len = self.ptr.size // cython.sizeof(lib.AVMotionVector)
 
     def __repr__(self):
@@ -29,15 +28,7 @@ class MotionVectors(SideData):
         if index < 0 or index >= self._len:
             raise IndexError(index)
 
-        try:
-            return self._vectors[index]
-        except KeyError:
-            pass
-
-        vector = self._vectors[index] = MotionVector(
-            _cinit_bypass_sentinel, self, index
-        )
-        return vector
+        return MotionVector(_cinit_bypass_sentinel, self, index)
 
     def __iter__(self):
         """Iterate over all motion vectors."""
diff --git a/av/sidedata/motionvectors.pyi b/av/sidedata/motionvectors.pyi
index 6b9971f..80690a4 100644
--- a/av/sidedata/motionvectors.pyi
+++ b/av/sidedata/motionvectors.pyi
@@ -1,14 +1,13 @@
-from typing import Any, overload
+from collections.abc import Iterator
+from typing import Any
 
 import numpy as np
 
 from .sidedata import SideData
 
 class MotionVectors(SideData):
-    @overload
     def __getitem__(self, index: int) -> MotionVector: ...
-    @overload
-    def __getitem__(self, index: slice) -> list[MotionVector]: ...
+    def __iter__(self) -> Iterator[MotionVector]: ...
     def __len__(self) -> int: ...
     def to_ndarray(self) -> np.ndarray[Any, Any]: ...
 
diff --git a/av/sidedata/sidedata.pyi b/av/sidedata/sidedata.pyi
index 7d60c94..94f500b 100644
--- a/av/sidedata/sidedata.pyi
+++ b/av/sidedata/sidedata.pyi
@@ -3,7 +3,6 @@ from enum import Enum
 from typing import ClassVar, cast, overload
 
 from av.buffer import Buffer
-from av.frame import Frame
 
 class Type(Enum):
     PANSCAN = cast(ClassVar[Type], ...)
@@ -43,7 +42,6 @@ class SideData(Buffer):
     type: Type
 
 class SideDataContainer(Mapping):
-    frame: Frame
     def __len__(self) -> int: ...
     def __iter__(self) -> Iterator[Type]: ...
     @overload
-- 
2.55.0

