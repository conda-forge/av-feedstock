From cd507dfe647661e3c5b7d9a3d33165497d8d10bb Mon Sep 17 00:00:00 2001
From: Mark Harfouche <mark.harfouche@gmail.com>
Date: Thu, 21 Mar 2024 08:57:12 -0400
Subject: [PATCH 1/2] Convert h264 tests to openh264 for lgpl build

---
diff --git a/tests/test_codec_context.py b/tests/test_codec_context.py
--- a/tests/test_codec_context.py
+++ b/tests/test_codec_context.py
@@ -419,8 +419,8 @@
                 assert frame.height == height
                 assert frame.format.name == pix_fmt
 
-    def test_encoding_h264(self) -> None:
-        self.video_encoding("h264", {"crf": "19"})
+    def test_encoding_libopenh264(self):
+        self.video_encoding("libopenh264", {"crf": "19"})
 
     def test_encoding_mpeg4(self) -> None:
         self.video_encoding("mpeg4")
@@ -536,8 +536,11 @@
         for i in decoded_gop_sizes:
             assert i == gop_size
 
-        final_gop_size = decoded_frame_count - max(keyframe_indices)
-        assert final_gop_size < gop_size
+        # libopenh264 only supports a reduced subset of the features and
+        # can't actually control GOP size correctly
+        if codec_name != "libopenh264":
+            final_gop_size = decoded_frame_count - max(keyframe_indices)
+            self.assertLessEqual(final_gop_size, gop_size)
 
     def test_encoding_pcm_s24le(self) -> None:
         self.audio_encoding("pcm_s24le")
@@ -621,7 +624,7 @@
 
 class TestNewlyExposedFields(TestCase):
     def test_encoder_scalars_roundtrip(self) -> None:
-        ctx = av.CodecContext.create("libx264", "w")
+        ctx = av.CodecContext.create("libopenh264", "w")
         assert isinstance(ctx, av.video.codeccontext.VideoCodecContext)
 
         ctx.bit_rate_tolerance = 4000
@@ -650,12 +653,12 @@
         assert ctx.frame_num == 0
 
     def test_stats_in_rejects_junk(self) -> None:
-        ctx = av.CodecContext.create("libx264", "w")
+        ctx = av.CodecContext.create("libopenh264", "w")
         with pytest.raises(TypeError):
             ctx.stats_in = 5  # type: ignore[assignment]
 
     def test_stats_in_out(self) -> None:
-        ctx = av.CodecContext.create("libx264", "w")
+        ctx = av.CodecContext.create("libopenh264", "w")
         assert ctx.stats_in is None
         assert ctx.stats_out is None
 
Only in b/tests: test_codec_context.py.orig
diff --git a/tests/test_encode.py b/tests/test_encode.py
--- a/tests/test_encode.py
+++ b/tests/test_encode.py
@@ -143,7 +143,7 @@
         path = self.sandboxed("video_with_pts.mov")
 
         with av.open(path, "w") as output:
-            stream = output.add_stream("h264", 24)
+            stream = output.add_stream("libopenh264", 24)
             assert stream in output.streams.video
             stream.width = WIDTH
             stream.height = HEIGHT
Only in b/tests: test_encode.py.orig
diff --git a/tests/test_subtitles.py b/tests/test_subtitles.py
--- a/tests/test_subtitles.py
+++ b/tests/test_subtitles.py
@@ -148,7 +148,7 @@
         output = io.BytesIO()
         with av.open(output, "w", format="mp4") as container:
             # MP4 requires video for subtitles
-            video_stream = container.add_stream("libx264", rate=30)
+            video_stream = container.add_stream("libopenh264", rate=30)
             video_stream.width = 640
             video_stream.height = 480
             video_stream.pix_fmt = "yuv420p"
Only in b/tests: test_subtitles.py.orig
